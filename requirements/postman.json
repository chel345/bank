      "name": "🧪 Full Test Flow (10 шагов)",
      "item": [
        {
          "name": "1️⃣ Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {"raw": "{{base_url}}/api/auth/health", "host": ["{{base_url}}"], "path": ["api", "auth", "health"]}
          }
        },
        {
          "name": "2️⃣ Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var d = pm.response.json();",
                  "    pm.collectionVariables.set('token', d.token);",
                  "    pm.collectionVariables.set('client_id', d.clientId.toString());",
