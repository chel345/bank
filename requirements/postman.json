{
  "info": {
    "name": "Bank System API Gateway",
    "description": "Полная коллекция эндпоинтов банковской системы через API Gateway (порт 8080). JWT токен сохраняется автоматически после логина. Все эндпоинты /me используют ID из JWT.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "managerKey",
      "value": "super-secret-manager-key-2024"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Auth",
      "description": "Аутентификация и регистрация. JWT токен сохраняется автоматически.",
      "item": [
        {
          "name": "Login (получить JWT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set(\"token\", jsonData.token);",
                  "    console.log(\"Токен сохранён: \" + jsonData.token.substring(0, 50) + \"...\");",
                  "} else {",
                  "    console.log(\"Ошибка логина: \" + pm.response.text());",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"phone\": \"+79001234567\",\n    \"password\": \"pass123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Вход по телефону и паролю. Возвращает JWT токен с ID пользователя."
          }
        },
        {
          "name": "Register (новый клиент)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set(\"token\", jsonData.token);",
                  "    console.log(\"Токен сохранён: \" + jsonData.token.substring(0, 50) + \"...\");",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "X-Manager-Key", "value": "{{managerKey}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"phone\": \"+79009999999\",\n    \"email\": \"newclient@mail.ru\",\n    \"password\": \"password123\",\n    \"passportData\": \"4510 111222\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "Регистрация нового клиента. Требуется ключ менеджера. Возвращает JWT токен."
          }
        }
      ]
    },
    {
      "name": "2. Clients - Мой профиль (/me)",
      "description": "Операции с СВОИМ профилем. ID берётся из JWT токена.",
      "item": [
        {
          "name": "Получить МОЙ профиль",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "url": {
              "raw": "{{baseUrl}}/api/clients/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "clients", "me"]
            },
            "description": "Получение данных ТЕКУЩЕГО пользователя. ID берётся из JWT."
          }
        },
        {
          "name": "Обновить МОЙ профиль",
          "request": {
            "method": "PUT",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"phone\": \"+79007777777\",\n    \"email\": \"mynewemail@mail.ru\",\n    \"password\": \"newpassword123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/clients/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "clients", "me"]
            },
            "description": "Обновление СВОЕГО профиля. Можно менять телефон, почту и пароль."
          }
        }
      ]
    },
